{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "storage.rules",
      ".git/**",
      ".netlify/**",
      ".agents/**",
      ".firebase/**",
      "tmp/**",
      ".gitignore",
      "node_modules/**",
      "src/**",
      "content/**",
      "config/**",
      "locks/**",
      "tools/**",
      "docs/**",
      "package.json",
      "PROJECT_RULES.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
